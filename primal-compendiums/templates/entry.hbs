{{#if @root.isScene}}
<li class="directory-item entry document scene" data-uuid="{{ uuid }}">
    {{#if thumb}}
    <img class="thumbnail" src="{{ thumb }}" alt="{{ name }}" loading="lazy">
    {{else if img}}
    <img class="thumbnail" src="{{ img }}" alt="{{ name }}" loading="lazy">
    {{/if}}
    <a class="entry-name" data-action="activateEntry">{{ name }}</a>
</li>
{{else}}
<li class="directory-item entry document {{ @root.documentCls }} flexrow" data-uuid="{{ uuid }}">
    {{#if img}}
    <img class="thumbnail" src="{{ img }}" alt="{{ name }}" loading="lazy">
    {{else}}
    <i class="pcs-entry-icon {{ @root.sidebarIcon }}" inert></i>
    {{/if}}
    <a class="entry-name ellipsis" data-action="activateEntry">{{ name }}</a>
</li>
{{/if}}
